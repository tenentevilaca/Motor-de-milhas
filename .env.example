# Este arquivo é opcional: dá pra configurar tudo pela tela "Configurações"
# (/settings.html) direto no navegador, sem precisar editar isso aqui. Use
# .env só se preferir configurar por variável de ambiente (ex: no Render).

# Porta do servidor
PORT=3000

# Fuso e horários das buscas automáticas (cron). Padrão: 3x/dia + varredura
# a cada 2h para promoções relâmpago (veja src/scheduler.js para o raciocínio).
SCHEDULE_TIMEZONE=America/Sao_Paulo
SCHEDULE_CRON_MAIN=0 6,13,21 * * *
SCHEDULE_CRON_FLASHSALE=0 */2 * * *
SCHEDULE_CRON_DEALFEED=*/10 * * * *
# DISABLE_SCHEDULER=true

# --- Comparação em dinheiro (dados reais) ---
# SerpApi (Google Flights): fonte real de preços que NÃO depende de API
# oficial da companhia nem de scraping direto do site dela — agrega dados
# via Google Flights de forma licenciada. 100 buscas/mês grátis, planos
# pagos depois. Cadastro: https://serpapi.com
SERPAPI_KEY=

# Kiwi.com Tequila: outro grande agregador (forte em low-cost). Cadastro
# grátis: https://tequila.kiwi.com
KIWI_TEQUILA_API_KEY=

# Travelpayouts: mais uma fonte real, cadastro geralmente só com e-mail
# (sem telefone). Grátis: https://www.travelpayouts.com — atenção: é um
# cache de preços já vistos, não busca ao vivo (pode não achar preço pra
# datas exatas específicas mesmo em rotas populares).
TRAVELPAYOUTS_TOKEN=

# Google Flights Live API (via RapidAPI): busca ao vivo de verdade (dados
# em tempo real do Google Flights). Cadastro sem telefone, mas é serviço
# PAGO por uso (cota grátis mensal limitada). Cadastro: https://rapidapi.com
RAPIDAPI_KEY=
# Preço vem em dólar — sem conversão em tempo real, usa essa taxa aproximada.
USD_TO_BRL_RATE=5.5

# --- Integrações de milhas (opcionais, exigem fonte de dados sua) ---
# Nenhuma dessas companhias tem API pública gratuita para award search, e
# fazer scraping direto viola os Termos de Uso da maioria delas (risco de
# bloqueio de conta/IP). Se você tiver uma integração própria (parceria
# oficial, GDS, ou um serviço de scraping que você mesmo administra e está
# autorizado a rodar), aponte para ela abaixo. Sem isso, o app mostra
# "pendente de configuração" e um link para checar manualmente.
AA_PROVIDER_URL=
LATAM_PROVIDER_URL=
SMILES_PROVIDER_URL=
AZUL_PROVIDER_URL=

# --- E-mail (SMTP genérico) ---
# Opções fáceis e gratuitas para começar: Brevo (300 e-mails/dia grátis),
# Resend (3000/mês grátis), ou Gmail com "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- WhatsApp: opção simples, sem cadastro em site nenhum ---
# 1. Salve +34 644 59 71 67 nos contatos do seu WhatsApp
# 2. Mande a mensagem "I allow callmebot to send me messages" pra esse número
# 3. Você recebe a API key de volta na hora
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=

# --- WhatsApp: opção avançada (Twilio) ---
# Usada só se CALLMEBOT_API_KEY não estiver definido. Exige conta com
# verificação de telefone. Sandbox gratuito: https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Telegram (provavelmente o canal mais fácil de todos) ---
# 1. Fale com @BotFather no Telegram, mande /newbot, copie o token
# 2. Mande uma mensagem qualquer pro seu bot recém-criado
# 3. Use GET /api/notify/telegram/chats (ou o botão "Descobrir meu Chat ID"
#    no formulário) pra achar o chat_id de cada busca
TELEGRAM_BOT_TOKEN=

# --- Feed de promoções (blogs de milhas) ---
# Opcional: por padrão já monitora Melhores Destinos, Passageiro de Primeira
# e Mestre das Milhas via RSS. Para usar outros blogs, uma URL de feed por
# linha ou separadas por vírgula (substitui a lista padrão).
DEAL_FEED_URLS=
