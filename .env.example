# Este arquivo é opcional: dá pra configurar tudo pela tela "Configurações"
# (/settings.html) direto no navegador, sem precisar editar isso aqui. Use
# .env só se preferir configurar por variável de ambiente (ex: no Render).

# Porta do servidor
PORT=3000

# Fuso e horários das buscas automáticas (cron). Padrão: 3x/dia + varredura
# a cada 2h para promoções relâmpago (veja src/scheduler.js para o raciocínio).
SCHEDULE_TIMEZONE=America/Sao_Paulo
SCHEDULE_CRON_MAIN=0 6,13,21 * * *
SCHEDULE_CRON_FLASHSALE=0 */2 * * *
# DISABLE_SCHEDULER=true

# --- Comparação em dinheiro (dados reais) ---
# Grátis em https://developers.amadeus.com (ambiente de testes)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# SerpApi (Google Flights): fonte real de preços que NÃO depende de API
# oficial da companhia nem de scraping direto do site dela — agrega dados
# via Google Flights de forma licenciada. 100 buscas/mês grátis, planos
# pagos depois. Cadastro: https://serpapi.com
SERPAPI_KEY=

# Kiwi.com Tequila: outro grande agregador (forte em low-cost). Cadastro
# grátis: https://tequila.kiwi.com
KIWI_TEQUILA_API_KEY=

# --- Integrações de milhas (opcionais, exigem fonte de dados sua) ---
# Nenhuma dessas companhias tem API pública gratuita para award search, e
# fazer scraping direto viola os Termos de Uso da maioria delas (risco de
# bloqueio de conta/IP). Se você tiver uma integração própria (parceria
# oficial, GDS, ou um serviço de scraping que você mesmo administra e está
# autorizado a rodar), aponte para ela abaixo. Sem isso, o app mostra
# "pendente de configuração" e um link para checar manualmente.
AA_PROVIDER_URL=
LATAM_PROVIDER_URL=
SMILES_PROVIDER_URL=
AZUL_PROVIDER_URL=

# --- E-mail (SMTP genérico) ---
# Opções fáceis e gratuitas para começar: Brevo (300 e-mails/dia grátis),
# Resend (3000/mês grátis), ou Gmail com "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- WhatsApp (Twilio) ---
# Sandbox gratuito para testes: https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
